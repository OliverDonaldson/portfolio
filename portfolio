#!/usr/bin/env python3
import sys
import os
import subprocess

def main():
    if len(sys.argv) < 2:
        print("Usage: ./portfolio <command>")
        print("  local   Start local dev server")
        print("  start   Build static site to docs/")
        sys.exit(1)

    command = sys.argv[1]

    if command == "local":
        print("🚀 Starting local dev server on http://localhost:5001")
        subprocess.run([sys.executable, "app.py"])
    elif command == "start":
        print("📦 Building static site...")
        subprocess.run([sys.executable, "freeze.py"])
    else:
        print(f"Unknown command: {command}")
        print("Available commands: local, start")
        sys.exit(1)

if __name__ == "__main__":
    main()
